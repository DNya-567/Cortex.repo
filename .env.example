# Ollama configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=tinyllama

# Qdrant configuration
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=code_chunks

# Embedding model (must be pulled in Ollama)
EMBED_MODEL=nomic-embed-text

# Authentication (set to true to require API keys for protected endpoints)
AUTH_ENABLED=false

# GitHub Integration (optional - unauthenticated works but limited to 60 req/hr)
# Get token: GitHub Settings → Developer settings → Personal access tokens
# → Classic → Generate new token → select: repo, read:user
GITHUB_TOKEN=your_github_token_here

# Multi-agent API keys (optional)
# Claude: https://console.anthropic.com/
# Get from: Console > API keys > Create new API key
ANTHROPIC_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
# Get from: API keys > Create new secret key
OPENAI_API_KEY=
